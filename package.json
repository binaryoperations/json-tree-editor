{
  "name": "json-tree-editor-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "SolidJS JSON tree editor monorepo",
  "license": "MIT",
  "author": "Shashank (https://github.com/shashank1010)",
  "homepage": "https://github.com/binaryoperations/json-tree-editor",
  "bugs": {
    "url": "https://github.com/binaryoperations/json-tree-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binaryoperations/json-tree-editor.git"
  },
  "scripts": {
    "dev": "pnpm --filter @json-tree-editor/demo dev",
    "build": "pnpm --filter @binaryoperations/json-tree-editor build && pnpm --filter @json-tree-editor/demo build",
    "build:lib": "pnpm --filter @binaryoperations/json-tree-editor build",
    "typecheck": "pnpm --filter @binaryoperations/json-tree-editor typecheck",
    "test": "pnpm --filter @binaryoperations/json-tree-editor test",
    "test:watch": "pnpm --filter @binaryoperations/json-tree-editor test:watch",
    "preview": "pnpm --filter @json-tree-editor/demo preview",
    "version:patch": "npm version patch --prefix json-tree-editor",
    "version:minor": "npm version minor --prefix json-tree-editor",
    "version:major": "npm version major --prefix json-tree-editor",
    "version:prerelease": "npm version prerelease --prefix json-tree-editor",
    "publish:json-tree-editor": "pnpm --filter @binaryoperations/json-tree-editor build && pnpm --filter @binaryoperations/json-tree-editor publish --access public",
    "release:patch": "pnpm version:patch && pnpm publish:json-tree-editor && echo '\\nRemember: git push && git push --tags'",
    "release:minor": "pnpm version:minor && pnpm publish:json-tree-editor && echo '\\nRemember: git push && git push --tags'",
    "release:major": "pnpm version:major && pnpm publish:json-tree-editor && echo '\\nRemember: git push && git push --tags'",
    "release:prerelease": "pnpm version:prerelease && pnpm publish:json-tree-editor && echo '\\nRemember: git push && git push --tags'"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@9.15.0"
}
