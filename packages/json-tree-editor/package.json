{
  "name": "json-tree-editor",
  "version": "0.1.0",
  "description": "Interactive JSON tree editor — Solid components + framework-agnostic web component",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "*.css",
    "./dist/web-component.js",
    "./src/web-component.tsx"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./web-component": {
      "types": "./dist/web-component.d.ts",
      "import": "./dist/web-component.js",
      "default": "./dist/web-component.js"
    },
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build && vite build --mode web-component && node ./scripts/copy-styles.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": false
    }
  },
  "devDependencies": {
    "solid-js": "^1.8.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.0.0",
    "vite-plugin-solid": "^2.10.2"
  },
  "keywords": [
    "json",
    "tree",
    "editor",
    "solid",
    "solidjs",
    "web-component",
    "custom-element"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/example/json-tree-editor.git",
    "directory": "packages/json-tree-editor"
  }
}
