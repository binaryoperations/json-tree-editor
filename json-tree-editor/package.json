{
  "name": "@binaryoperations/json-tree-editor",
  "version": "1.0.6",
  "description": "Interactive JSON tree editor — Solid components + framework-agnostic web component",
  "type": "module",
  "license": "MIT",
  "author": "Shashank (https://github.com/shashank1010)",
  "homepage": "https://github.com/binaryoperations/json-tree-editor",
  "bugs": {
    "url": "https://github.com/binaryoperations/json-tree-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binaryoperations/json-tree-editor.git",
    "directory": "json-tree-editor"
  },
  "sideEffects": [
    "*.css",
    "./dist/web-component.js",
    "./src/web-component.tsx"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "solid": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./utils": {
      "types": "./src/utils.ts",
      "solid": "./src/utils.ts",
      "import": "./src/utils.ts",
      "default": "./src/utils.ts"
    },
    "./dnd": {
      "types": "./src/dnd.ts",
      "solid": "./src/dnd.ts",
      "import": "./src/dnd.ts",
      "default": "./src/dnd.ts"
    },
    "./web-component": {
      "types": "./dist/web-component.d.ts",
      "import": "./dist/web-component.js",
      "default": "./dist/web-component.js"
    },
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:restore": "node ./scripts/package-json-for-publish.mjs restore",
    "prepack": "node ./scripts/prepack.mjs",
    "postpack": "node ./scripts/package-json-for-publish.mjs restore"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^30.0.1",
    "solid-js": "^1.8.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.0.0",
    "vite-plugin-solid": "^2.10.2",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "json",
    "tree",
    "editor",
    "solid",
    "solidjs",
    "web-component",
    "custom-element"
  ]
}
